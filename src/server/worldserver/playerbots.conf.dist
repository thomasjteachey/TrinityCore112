###################################################################################################
# PLAYERBOT CONFIG
###################################################################################################

[worldserver]

#    Playerbot.Enable
#        Description: Enables Playerbot systems.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.Enable = 0

#    Playerbot.PvpCore.Enable
#        Description: Enables Playerbot PvP core trigger/value scaffolding and battleground state detection.
#                     This phase only wires infrastructure and does not execute class spell logic.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.PvpCore.Enable = 0

#    Playerbot.PvpTactics.Enable
#        Description: Enables battleground tactical trigger/action selection plus primitive execution
#                     for waiting/active/often/low-health/low-mana/timer-bg flows, including
#                     objective-state flag-carrier pursuit/protection movement in WSG/EotS contexts.
#                     This remains default OFF and does not change queue policy or class rotation logic.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.PvpTactics.Enable = 0

#    Playerbot.PvpLifecycle.Enable
#        Description: Enables battleground/arena queue participation lifecycle scaffolding and random-bot
#                     participation hooks. Real players are always excluded from these hooks.
#                     Battleground queue primitive currently targets Warsong Gulch.
#                     This phase wires lifecycle entry points only and does not
#                     include class spell logic, queue cadence tuning, or SQL payloads.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.PvpLifecycle.Enable = 0

#    Playerbot.PvpLifecycle.QueueOnly.ScarletChapelAccounts
#    Playerbot.PvpLifecycle.QueueOnly.BlackrockThroneAccounts
#    Playerbot.PvpLifecycle.QueueOnly.BattleForGilneasAccounts
#    Playerbot.PvpLifecycle.QueueOnly.TwinPeaksAccounts
#    Playerbot.PvpLifecycle.QueueOnly.ArathiBasinAccounts
#    Playerbot.PvpLifecycle.QueueOnly.WarsongGulchAccounts
#    Playerbot.PvpLifecycle.QueueOnly.ArenaAccounts
#        Description: Comma-separated account IDs for queue segmentation. Managed bots on these accounts
#                     are constrained to the corresponding queue family only.
#                     ArenaAccounts suppress battleground queue joins so those bots can queue arena only.
#                     BlackrockThrone uses QueueOnly.BlackrockThroneBgTypeId for its battleground type ID.
#        Default:     "" (empty list)

Playerbot.PvpLifecycle.QueueOnly.ScarletChapelAccounts =
Playerbot.PvpLifecycle.QueueOnly.BlackrockThroneAccounts =
Playerbot.PvpLifecycle.QueueOnly.BattleForGilneasAccounts =
Playerbot.PvpLifecycle.QueueOnly.TwinPeaksAccounts =
Playerbot.PvpLifecycle.QueueOnly.ArathiBasinAccounts =
Playerbot.PvpLifecycle.QueueOnly.WarsongGulchAccounts =
Playerbot.PvpLifecycle.QueueOnly.ArenaAccounts =

#    Playerbot.PvpLifecycle.QueueOnly.BlackrockThroneBgTypeId
#        Description: Battleground type ID used for Playerbot.PvpLifecycle.QueueOnly.BlackrockThroneAccounts.
#                     Set this to your custom Blackrock Throne battleground type ID.
#        Default:     0 (disabled; accounts in BlackrockThroneAccounts fall back to other configured rules)

Playerbot.PvpLifecycle.QueueOnly.BlackrockThroneBgTypeId = 0

#    Playerbot.PvpLifecycle.ObsidianColosseum.Clone.Enable
#        Description: Creates transient "Dark <name>" player clones entirely in memory when a real
#                     player enters Obsidian Colosseum. No account or character database rows are used.
#                     The legacy CloneAccountId setting is accepted only as an enable/disable fallback;
#                     its numeric value is never used as an account ID.
#        Default:     0 (disabled)

Playerbot.PvpLifecycle.ObsidianColosseum.Clone.Enable = 0

# Legacy enable fallback. Nonzero enables clones only when Clone.Enable is absent.
Playerbot.PvpLifecycle.ObsidianColosseum.CloneAccountId = 0

#    Playerbot.PvpClassSpells.Enable
#        Description: Enables Phase-4 class/spec PvP spell decision slices.
#                     Current implementation provides reference-aligned trigger/action vocabulary
#                     plus explicit ordered fallback alternates and strict cast-point validation
#                     (known rank, cooldown/GCD/cast state, resource cost, range/LOS, target validity).
#                     Feature remains default OFF.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.PvpClassSpells.Enable = 0

#    Playerbot.PvpClassSpells.RehgarMovementDiagnostics
#        Description: Sends Rehgar's Fury movement diagnostics as server system messages
#                     to every online GM. Disable after capturing the live movement trace.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Playerbot.PvpClassSpells.RehgarMovementDiagnostics = 1

#    Playerbot.RandomPopulation.Enable
#        Description: Enables random-bot population manager orchestration. When enabled and runtime started,
#                     periodic rebalance ticks evaluate online random-bot count (bots are always identified as
#                     explicit managed bot accounts from Playerbot.RandomPopulation.BotAccountIds and attempt
#                     server-side login/logout orchestration for those accounts/characters only.
#                     Real players are hard-excluded from all lifecycle and population automation.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.RandomPopulation.Enable = 0

#    Playerbot.RandomPopulation.TargetMin
#        Description: Minimum target number of online random bots maintained by the population manager.
#        Default:     0

Playerbot.RandomPopulation.TargetMin = 0

#    Playerbot.RandomPopulation.TargetMax
#        Description: Maximum target number of online random bots maintained by the population manager.
#                     If greater than TargetMin, rebalance deterministically rotates target in range.
#        Default:     0

Playerbot.RandomPopulation.TargetMax = 0

#    Playerbot.RandomPopulation.RebalanceIntervalMs
#        Description: Rebalance cadence for population manager ticks in milliseconds.
#        Default:     15000 (15 seconds)

Playerbot.RandomPopulation.RebalanceIntervalMs = 15000

#    Playerbot.RandomPopulation.BotAccountIds
#        Description: Comma-separated account IDs reserved for random population bot pool selection.
#                     Only characters from these accounts are considered for offline pool candidate picks.
#                     This list is also the explicit managed identity boundary for lifecycle/login/logout:
#                     characters outside this list are always treated as real-player safety scope.
#                     Keep this list strictly bot-only to prevent selecting real-player characters.
#        Default:     "" (empty, no pool)

Playerbot.RandomPopulation.BotAccountIds =

#    Playerbot.RandomPopulation.MinLevel
#        Description: Minimum character level for offline pool selection.
#        Default:     10

Playerbot.RandomPopulation.MinLevel = 10

#    Playerbot.RandomPopulation.MaxLevel
#        Description: Maximum character level for offline pool selection.
#        Default:     80

Playerbot.RandomPopulation.MaxLevel = 80

#    Playerbot.RandomPopulation.AllianceRatioPercent
#        Description: Soft alliance percentage target used while selecting login candidates.
#                     50 means roughly even faction split over time.
#        Default:     50

Playerbot.RandomPopulation.AllianceRatioPercent = 50

#    Playerbot.RandomPopulation.MaxOnlineBotsPerAccount
#        Description: Maximum random bots allowed online at once per account during candidate selection.
#                     Set to 0 to disable the cap (allows multiple bots per account without manager-side limit).
#        Default:     0

Playerbot.RandomPopulation.MaxOnlineBotsPerAccount = 0

#    Playerbot.RandomPopulation.SelectionHistorySize
#        Description: Number of recently selected offline bot guids to deprioritize during deterministic
#                     candidate ordering to reduce immediate repeats while preserving reproducibility.
#        Default:     48

Playerbot.RandomPopulation.SelectionHistorySize = 48

###################################################################################################
# RESOURCE GOVERNOR
#
#    Watches the average world update time and sheds custom-match bot load before the whole
#    server degrades. Matches with human PARTICIPANTS are never throttled or ended by the
#    governor; it only limits bot fill for custom games and, under sustained hard pressure,
#    ends bot-only matches (unwatched ones first, then spectator-only ones).
###################################################################################################

#    Playerbot.Governor.Enable
#        Description: Master switch for the resource governor.
#        Default:     1

Playerbot.Governor.Enable = 1

#    Playerbot.Governor.SoftUpdateTimeMs
#        Description: Average world update time (ms) above which the server is considered under
#                     soft pressure: new custom-match bot additions are capped at
#                     Playerbot.Governor.SoftMatchBotCap per match.
#        Default:     110

Playerbot.Governor.SoftUpdateTimeMs = 110

#    Playerbot.Governor.HardUpdateTimeMs
#        Description: Average world update time (ms) above which the server is under hard
#                     pressure: no new custom-match bots may be added, bot-only matches may not
#                     start, and sustained pressure culls running bot-only/spectator-only matches.
#        Default:     180

Playerbot.Governor.HardUpdateTimeMs = 180

#    Playerbot.Governor.HardSustainSeconds
#        Description: Hard pressure must persist this long before the first match is culled.
#        Default:     10

Playerbot.Governor.HardSustainSeconds = 10

#    Playerbot.Governor.CullCooldownSeconds
#        Description: Minimum time between two governor match culls, so the update-time average
#                     can settle after each shed before deciding again.
#        Default:     20

Playerbot.Governor.CullCooldownSeconds = 20

#    Playerbot.Governor.SoftMatchBotCap
#        Description: Maximum bots/clones a single custom match may request while under soft
#                     pressure. Has no effect at normal load.
#        Default:     20

Playerbot.Governor.SoftMatchBotCap = 20

#    Playerbot.Governor.MaxTotalCustomMatchBots
#        Description: Hard cap on bots/clones across all running custom matches plus the lobby
#                     roster being edited, regardless of update time. 0 disables the cap.
#        Default:     160

Playerbot.Governor.MaxTotalCustomMatchBots = 160

#    Playerbot.Governor.BotShedCooldownSeconds
#        Description: Once no cullable bot-only/spectator-only match remains but hard pressure
#                     persists, one bot is removed from the human-participant match with the
#                     largest bot roster every this many seconds (dead bots and the larger team
#                     are preferred) until the update-time average recovers.
#        Default:     5

Playerbot.Governor.BotShedCooldownSeconds = 5
