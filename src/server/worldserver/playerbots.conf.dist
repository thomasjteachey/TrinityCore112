###################################################################################################
# PLAYERBOT CONFIG
###################################################################################################

[worldserver]

#    Playerbot.Enable
#        Description: Enables Playerbot systems.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.Enable = 0

#    Playerbot.PvpCore.Enable
#        Description: Enables Playerbot PvP core trigger/value scaffolding and battleground state detection.
#                     This phase only wires infrastructure and does not execute class spell logic.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.PvpCore.Enable = 0

#    Playerbot.PvpTactics.Enable
#        Description: Enables battleground tactical trigger/action selection plus primitive execution
#                     for waiting/active/often/low-health/low-mana/timer-bg flows, including
#                     objective-state flag-carrier pursuit/protection movement in WSG/EotS contexts.
#                     This remains default OFF and does not change queue policy or class rotation logic.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.PvpTactics.Enable = 0

#    Playerbot.PvpLifecycle.Enable
#        Description: Enables battleground/arena queue participation lifecycle scaffolding and random-bot
#                     participation hooks. Real players are always excluded from these hooks.
#                     Battleground queue primitive currently targets Warsong Gulch.
#                     This phase wires lifecycle entry points only and does not
#                     include class spell logic, queue cadence tuning, or SQL payloads.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.PvpLifecycle.Enable = 0

#    Playerbot.PvpLifecycle.QueueOnly.ScarletChapelAccounts
#    Playerbot.PvpLifecycle.QueueOnly.BlackrockThroneAccounts
#    Playerbot.PvpLifecycle.QueueOnly.BattleForGilneasAccounts
#    Playerbot.PvpLifecycle.QueueOnly.TwinPeaksAccounts
#    Playerbot.PvpLifecycle.QueueOnly.ArathiBasinAccounts
#    Playerbot.PvpLifecycle.QueueOnly.WarsongGulchAccounts
#    Playerbot.PvpLifecycle.QueueOnly.ArenaAccounts
#        Description: Comma-separated account IDs for queue segmentation. Managed bots on these accounts
#                     are constrained to the corresponding queue family only.
#                     ArenaAccounts suppress battleground queue joins so those bots can queue arena only.
#                     BlackrockThrone uses QueueOnly.BlackrockThroneBgTypeId for its battleground type ID.
#        Default:     "" (empty list)

Playerbot.PvpLifecycle.QueueOnly.ScarletChapelAccounts =
Playerbot.PvpLifecycle.QueueOnly.BlackrockThroneAccounts =
Playerbot.PvpLifecycle.QueueOnly.BattleForGilneasAccounts =
Playerbot.PvpLifecycle.QueueOnly.TwinPeaksAccounts =
Playerbot.PvpLifecycle.QueueOnly.ArathiBasinAccounts =
Playerbot.PvpLifecycle.QueueOnly.WarsongGulchAccounts =
Playerbot.PvpLifecycle.QueueOnly.ArenaAccounts =

#    Playerbot.PvpLifecycle.QueueOnly.BlackrockThroneBgTypeId
#        Description: Battleground type ID used for Playerbot.PvpLifecycle.QueueOnly.BlackrockThroneAccounts.
#                     Set this to your custom Blackrock Throne battleground type ID.
#        Default:     0 (disabled; accounts in BlackrockThroneAccounts fall back to other configured rules)

Playerbot.PvpLifecycle.QueueOnly.BlackrockThroneBgTypeId = 0

#    Playerbot.PvpLifecycle.ObsidianColosseum.Clone.Enable
#        Description: Creates transient "Dark <name>" player clones entirely in memory when a real
#                     player enters Obsidian Colosseum. No account or character database rows are used.
#                     The legacy CloneAccountId setting is accepted only as an enable/disable fallback;
#                     its numeric value is never used as an account ID.
#        Default:     0 (disabled)

Playerbot.PvpLifecycle.ObsidianColosseum.Clone.Enable = 0

# Legacy enable fallback. Nonzero enables clones only when Clone.Enable is absent.
Playerbot.PvpLifecycle.ObsidianColosseum.CloneAccountId = 0

#    Playerbot.PvpClassSpells.Enable
#        Description: Enables Phase-4 class/spec PvP spell decision slices.
#                     Current implementation provides reference-aligned trigger/action vocabulary
#                     plus explicit ordered fallback alternates and strict cast-point validation
#                     (known rank, cooldown/GCD/cast state, resource cost, range/LOS, target validity).
#                     Feature remains default OFF.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.PvpClassSpells.Enable = 0

#    Playerbot.PvpClassSpells.Interrupt.ReactionMinMs
#    Playerbot.PvpClassSpells.Interrupt.ReactionMaxMs
#        Description: Humanized interrupt reflexes. When a bot notices an enemy cast it rolls
#                     a uniform reaction delay in [Min, Max] milliseconds before its interrupt
#                     (Counterspell, Kick, Pummel, Earth Shock, Spell Lock, Scatter Shot,
#                     Hammer of Justice, Repentance, Rebuke, ...) becomes eligible. Short casts
#                     can slip under a slow roll entirely. ReactionMaxMs = 0 restores the old
#                     instant-reflex behavior. Values are clamped to [0, 5000] and Max is
#                     raised to Min when configured lower.
#        Default:     200 (ReactionMinMs)
#                     1000 (ReactionMaxMs)

Playerbot.PvpClassSpells.Interrupt.ReactionMinMs = 200
Playerbot.PvpClassSpells.Interrupt.ReactionMaxMs = 1000

#    Playerbot.PvpClassSpells.Interrupt.CommitWindowMs
#        Description: Fake-cast bait window in milliseconds. Once a bot's rolled reaction time
#                     arrives it has committed to pressing its interrupt: if the enemy cast
#                     disappears within this window immediately before that moment, the
#                     interrupt is fired anyway at the now-idle target and wasted. Cancelling
#                     earlier than the window makes the bot hold the interrupt instead.
#                     Larger values make bots easier to juke; 0 disables wasted presses
#                     entirely. Clamped to [0, 2000].
#        Default:     200

Playerbot.PvpClassSpells.Interrupt.CommitWindowMs = 200

#    Playerbot.PvpClassSpells.RehgarMovementDiagnostics
#        Description: Sends Rehgar's Fury movement diagnostics as server system messages
#                     to every online GM. Disable after capturing the live movement trace.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Playerbot.PvpClassSpells.RehgarMovementDiagnostics = 1

#    Playerbot.RandomPopulation.Enable
#        Description: Enables random-bot population manager orchestration. When enabled and runtime started,
#                     periodic rebalance ticks evaluate online random-bot count (bots are always identified as
#                     explicit managed bot accounts from Playerbot.RandomPopulation.BotAccountIds and attempt
#                     server-side login/logout orchestration for those accounts/characters only.
#                     Real players are hard-excluded from all lifecycle and population automation.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.RandomPopulation.Enable = 0

#    Playerbot.RandomPopulation.TargetMin
#        Description: Minimum target number of online random bots maintained by the population manager.
#        Default:     0

Playerbot.RandomPopulation.TargetMin = 0

#    Playerbot.RandomPopulation.TargetMax
#        Description: Maximum target number of online random bots maintained by the population manager.
#                     If greater than TargetMin, rebalance deterministically rotates target in range.
#        Default:     0

Playerbot.RandomPopulation.TargetMax = 0

#    Playerbot.RandomPopulation.RebalanceIntervalMs
#        Description: Rebalance cadence for population manager ticks in milliseconds.
#        Default:     15000 (15 seconds)

Playerbot.RandomPopulation.RebalanceIntervalMs = 15000

#    Playerbot.RandomPopulation.BotAccountIds
#        Description: Comma-separated account IDs reserved for random population bot pool selection.
#                     Only characters from these accounts are considered for offline pool candidate picks.
#                     This list is also the explicit managed identity boundary for lifecycle/login/logout:
#                     characters outside this list are always treated as real-player safety scope.
#                     Keep this list strictly bot-only to prevent selecting real-player characters.
#        Default:     "" (empty, no pool)

Playerbot.RandomPopulation.BotAccountIds =

#    Playerbot.RandomPopulation.MinLevel
#        Description: Minimum character level for offline pool selection.
#        Default:     10

Playerbot.RandomPopulation.MinLevel = 10

#    Playerbot.RandomPopulation.MaxLevel
#        Description: Maximum character level for offline pool selection.
#        Default:     80

Playerbot.RandomPopulation.MaxLevel = 80

#    Playerbot.RandomPopulation.AllianceRatioPercent
#        Description: Soft alliance percentage target used while selecting login candidates.
#                     50 means roughly even faction split over time.
#        Default:     50

Playerbot.RandomPopulation.AllianceRatioPercent = 50

#    Playerbot.RandomPopulation.MaxOnlineBotsPerAccount
#        Description: Maximum random bots allowed online at once per account during candidate selection.
#                     Set to 0 to disable the cap (allows multiple bots per account without manager-side limit).
#        Default:     0

Playerbot.RandomPopulation.MaxOnlineBotsPerAccount = 0

#    Playerbot.RandomPopulation.SelectionHistorySize
#        Description: Number of recently selected offline bot guids to deprioritize during deterministic
#                     candidate ordering to reduce immediate repeats while preserving reproducibility.
#        Default:     48

Playerbot.RandomPopulation.SelectionHistorySize = 48

###################################################################################################
# RESOURCE GOVERNOR
#
#    Watches the average world update time and sheds custom-match bot load before the whole
#    server degrades. Matches with human PARTICIPANTS are never throttled or ended by the
#    governor; it only limits bot fill for custom games and, under sustained hard pressure,
#    ends bot-only matches (unwatched ones first, then spectator-only ones).
###################################################################################################

#    Playerbot.Governor.Enable
#        Description: Master switch for the resource governor.
#        Default:     1

Playerbot.Governor.Enable = 1

#    Playerbot.Governor.SoftUpdateTimeMs
#        Description: Average world update time (ms) above which the server is considered under
#                     soft pressure: new custom-match bot additions are capped at
#                     Playerbot.Governor.SoftMatchBotCap per match.
#        Default:     110

Playerbot.Governor.SoftUpdateTimeMs = 110

#    Playerbot.Governor.HardUpdateTimeMs
#        Description: Average world update time (ms) above which the server is under hard
#                     pressure: no new custom-match bots may be added, bot-only matches may not
#                     start, and sustained pressure culls running bot-only/spectator-only matches.
#        Default:     180

Playerbot.Governor.HardUpdateTimeMs = 180

#    Playerbot.Governor.HardSustainSeconds
#        Description: Hard pressure must persist this long before the first match is culled.
#        Default:     10

Playerbot.Governor.HardSustainSeconds = 10

#    Playerbot.Governor.CullCooldownSeconds
#        Description: Minimum time between two governor match culls, so the update-time average
#                     can settle after each shed before deciding again.
#        Default:     20

Playerbot.Governor.CullCooldownSeconds = 20

#    Playerbot.Governor.SoftMatchBotCap
#        Description: Maximum bots/clones a single custom match may request while under soft
#                     pressure. Has no effect at normal load.
#        Default:     20

Playerbot.Governor.SoftMatchBotCap = 20

#    Playerbot.Governor.MaxTotalCustomMatchBots
#        Description: Hard cap on bots/clones across all running custom matches plus the lobby
#                     roster being edited, regardless of update time. 0 disables the cap.
#        Default:     160

Playerbot.Governor.MaxTotalCustomMatchBots = 160

#    Playerbot.Governor.BotShedCooldownSeconds
#        Description: Once no cullable bot-only/spectator-only match remains but hard pressure
#                     persists, one bot is removed from the human-participant match with the
#                     largest bot roster every this many seconds (dead bots and the larger team
#                     are preferred) until the update-time average recovers.
#        Default:     5

Playerbot.Governor.BotShedCooldownSeconds = 5

#    Playerbot.PvpDecision.GlobalLock
#        Description: Diagnostic switch. 1 restores the old behavior of serializing every bot
#                     decision tick through one global mutex instead of one lock per map
#                     instance. Costs multi-battleground parallelism; use it to isolate whether
#                     a crash or corruption comes from cross-map bot concurrency.
#        Default:     0

Playerbot.PvpDecision.GlobalLock = 0

###################################################################################################
# PLAYERBOT PVE (COMPANIONS, LEVELING, GRINDING)
###################################################################################################

#    Playerbot.Pve.Enable
#        Description: Master switch for open-world PvE bot behavior: companion bots that follow,
#                     assist and level with a human, and (optionally) autonomous grinding for the
#                     idle random-bot population. Combat decisions reuse the PvP class-spell
#                     engine, so Playerbot.Enable and Playerbot.PvpClassSpells.Enable must also
#                     be on for bots to actually fight.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.Pve.Enable = 0

#    Playerbot.Pve.Companion.FollowDistance
#        Description: Follow distance in yards for a companion trailing its master out of combat.
#        Default:     2.5

Playerbot.Pve.Companion.FollowDistance = 2.5

#    Playerbot.Pve.Companion.AssistRadius
#        Description: Maximum distance in yards at which a companion will pick up a fight:
#                     attackers of itself, its master or its group, and the master's active
#                     combat victim.
#        Default:     45

Playerbot.Pve.Companion.AssistRadius = 45

#    Playerbot.Pve.AutoReviveSeconds
#        Description: A dead bot first waits this long for a player resurrection (it accepts any
#                     pending resurrect request automatically). After the delay it releases,
#                     self-resurrects at 66% and - if it has a master - teleports back to them.
#        Default:     30

Playerbot.Pve.AutoReviveSeconds = 30

#    Playerbot.Pve.RestHealthPct
#    Playerbot.Pve.RestManaPct
#        Description: Out of combat, bots sit down to eat below the health threshold and drink
#                     below the mana threshold (the same free food/water the battleground
#                     preparation logic uses), resuming at ~99%.
#        Default:     60 / 50

Playerbot.Pve.RestHealthPct = 60
Playerbot.Pve.RestManaPct = 50

#    Playerbot.Pve.AutoLearnSpellsOnLevelUp
#        Description: When a managed bot levels up, it learns every class-trainer spell it now
#                     qualifies for (free, rank chains included), so leveling bots keep a usable
#                     rotation without visiting trainers.
#        Default:     1 - (Enabled)

Playerbot.Pve.AutoLearnSpellsOnLevelUp = 1

#    Playerbot.PveGrind.Enable
#        Description: Idle managed random bots (online through Playerbot.RandomPopulation.*, not
#                     grouped with a human, not in a battleground or its queue) hunt nearby
#                     creatures, rest between kills and wander, gaining experience and levels.
#                     Battleground participation still wins: the queue sweep can pull grinding
#                     bots into a battleground whenever a human queues.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.PveGrind.Enable = 0

#    Playerbot.PveGrind.SearchRadius
#        Description: Radius in yards a grinding bot scans for its next creature target.
#        Default:     60

Playerbot.PveGrind.SearchRadius = 60

#    Playerbot.PveGrind.WanderRadius
#        Description: When nothing attackable is nearby, the bot strolls to a random reachable
#                     point within this many yards every 12-25 seconds.
#        Default:     40

Playerbot.PveGrind.WanderRadius = 40

#    Playerbot.PveGrind.MaxLevelAbove
#    Playerbot.PveGrind.MaxLevelBelow
#        Description: Level window for grind targets relative to the bot's own level. Creatures
#                     more than MaxLevelAbove levels higher or MaxLevelBelow levels lower are
#                     ignored.
#        Default:     3 / 5

Playerbot.PveGrind.MaxLevelAbove = 3
Playerbot.PveGrind.MaxLevelBelow = 5

#    Playerbot.PveGrind.AllowElites
#        Description: Allow grinding bots to pull elite and world-boss creatures.
#        Default:     0 - (Disabled)

Playerbot.PveGrind.AllowElites = 0

# The in-game command surface for PvE bots:
#   .playerbot pve summon <name>   - log a bot-account character in, teleport it to you and
#                                    join it to your group (it follows and assists from then on)
#   .playerbot pve dismiss [name]  - ungroup and log out the selected/named companion
#   .playerbot pve status          - PvE state of the selected bot
# Whisper commands a master can send their companion:
#   follow / stay / attack / passive / come / dismiss
#
# Auction-house population is handled by the core AuctionHouseBot again (it was previously
# hard-disabled in this fork): configure the AuctionHouseBot.* block in worldserver.conf,
# most importantly AuctionHouseBot.Account plus Seller/Buyer.Enabled.

#    Playerbot.Pve.Loot.Enable
#        Description: Bots loot gold and items from their own (or their group's) kills,
#                     walking to the corpse first.
#        Default:     1 - (Enabled)

Playerbot.Pve.Loot.Enable = 1

#    Playerbot.Pve.Vendor.Enable
#        Description: When bags run low (< 4 free slots) or any equipped item drops under 35%
#                     durability, autonomous bots walk to the nearest friendly vendor within
#                     200 yards, sell their grey items and repair (if the vendor can).
#        Default:     1 - (Enabled)

Playerbot.Pve.Vendor.Enable = 1

#    Playerbot.Pve.Quests.Enable
#        Description: Autonomous bots accept quests from nearby quest givers, prefer grind
#                     targets that advance their kill objectives, and turn completed quests in
#                     (choosing a usable reward). Kill-credit quests complete naturally;
#                     gathering/exploration objectives are not pursued yet.
#        Default:     1 - (Enabled)

Playerbot.Pve.Quests.Enable = 1

#    Playerbot.Pve.EquipUpgrades.Enable
#        Description: Bots equip looted or quest-rewarded weapons/armor when the item level
#                     beats what they are wearing (empty slots are always filled).
#        Default:     1 - (Enabled)

Playerbot.Pve.EquipUpgrades.Enable = 1

#    Playerbot.Pve.Buffs.Enable
#        Description: Out of combat, bots keep their class self-buffs up (Mark of the Wild,
#                     Power Word: Fortitude, Arcane Intellect, armors, aspects, Lightning
#                     Shield, ...) at real mana cost, gated above 60% mana so buffing never
#                     fights the eat/drink loop.
#        Default:     1 - (Enabled)

Playerbot.Pve.Buffs.Enable = 1

#    Playerbot.Pve.Talents.Enable
#        Description: Bots spend talent points as they level: each character deterministically
#                     picks one of its class's three signature specs (the same signatures the
#                     rotation engine detects) and greedily fills that tree tier by tier,
#                     overflowing into the others when capped. Safe against custom talent-tree
#                     rebuilds - selection keys on stable spell ids, not talent ids.
#        Default:     1 - (Enabled)

Playerbot.Pve.Talents.Enable = 1

#    Playerbot.PveGrind.Relocate.Enable
#        Description: When a grinding bot repeatedly finds nothing attackable (empty or
#                     outleveled area), the world-thread relocator teleports it to a random
#                     cluster of level-appropriate hostile spawns on the vanilla continents.
#                     Enemy-faction zones, water landings and spots near real players are
#                     rejected; the Z coordinate is grounded before the teleport.
#        Default:     1 - (Enabled)

Playerbot.PveGrind.Relocate.Enable = 1

#    Playerbot.PveGrind.Relocate.DryWandersBeforeMove
#        Description: How many consecutive fruitless wander cycles (no creature found within
#                     3x the search radius) trigger a relocation.
#        Default:     5

Playerbot.PveGrind.Relocate.DryWandersBeforeMove = 5

#    Playerbot.Pve.Quests.Enable also covers gameobject objectives: bots walk to and use
#    quest goobers (RequiredNpcOrGo credit) and loot quest chests within 120 yards of their
#    grind area. Gathering professions and exploration objectives remain unimplemented.

#    Playerbot.PveGrind.Relocate.Maps
#        Description: Comma-separated map ids the relocation cache samples grind spots from.
#                     Barracks+ keeps the vanilla continents; a wrath realm can use "0,1,530,571".
#                     The cache builds once at first use, so changes need a restart.
#        Default:     "0,1"

Playerbot.PveGrind.Relocate.Maps = "0,1"

#    Playerbot.Pve.Rest.UseConsumables
#        Description: Realm economy switch for bot recovery. 0 = bots cast the free eat/drink
#                     spells (Legionnaire+ style). 1 = bots buy real food/water (and ammo for
#                     ranged weapons) from vendors with their own gold and consume them, and an
#                     empty pantry triggers a vendor errand (Barracks+ style).
#        Default:     0

Playerbot.Pve.Rest.UseConsumables = 0

#    Playerbot.Pve.PvpOnlyAccountIds
#        Description: Comma-separated account ids whose bots are PvP-only: no PvE behavior of
#                     any kind (no grinding, errands, gear changes, talents or economy). They
#                     idle wherever they are parked - typically a sanctuary players cannot
#                     reach - and only answer the battleground orchestration, which returns
#                     them to that spot when the match ends. Empty disables the feature.
#        Default:     ""

Playerbot.Pve.PvpOnlyAccountIds = ""

#    Playerbot.Pve.DeclineGroupInvites
#        Description: Hardcore realms: bots never join groups. Group invites are declined and
#                     companion summons refused. 0 keeps the normal companion behavior.
#        Default:     0
Playerbot.Pve.DeclineGroupInvites = 0

#    Playerbot.OpenWorldNoFriendlyFire
#        Description: Managed playerbots are one team in the open world: they are never valid
#                     attack targets for each other outside battlegrounds and arenas, even when
#                     everyone is FFA-flagged on a hardcore realm. Battleground team rules are
#                     unaffected.
#        Default:     1
Playerbot.OpenWorldNoFriendlyFire = 1

#    Playerbot.Pve.ZoneGuardians.PerZone
#        Description: This many bots per classic zone become that zone's permanent guardians:
#                     set to the zone's classic level cap, XP gain frozen, relocated only within
#                     their zone, excluded from rebirth and the reset command. Slots are claimed
#                     first-come each uptime (previous guardians re-claim first). 0 disables.
#        Default:     0
Playerbot.Pve.ZoneGuardians.PerZone = 0

#    Playerbot.Pve.RebirthAtMaxLevel.Percent
#        Description: This percent of the managed fleet (guid-keyed, deterministic) is reborn
#                     on reaching the level cap: the full level-1 reset (gear, spells, talents,
#                     quests, money wiped; ported home) so the leveling world stays populated.
#                     PvP-only bots and companions are never reborn. 0 disables.
#        Default:     0
Playerbot.Pve.RebirthAtMaxLevel.Percent = 0

#    Playerbot.Pve.Travel.WalkMaxDistance
#        Description: Relocations and town runs within this range are WALKED (segmented mmap
#                     pathing, fights allowed en route, stuck/timeout falls back to teleport).
#                     0 restores teleport-only travel.
#        Default:     900

Playerbot.Pve.Travel.WalkMaxDistance = 900

#    Playerbot.Pve.Travel.UseFlightPaths
#        Description: For longer travel, bots take real flight-master routes when the departure
#                     node is nearby and a route exists (BFS over taxi edges, up to 7 hops),
#                     paying the fare from their own gold. Teleport remains the last fallback.
#        Default:     1 - (Enabled)

Playerbot.Pve.Travel.UseFlightPaths = 1

#    Playerbot.Pve.AuctionBuy.Enable
#        Description: Bots browse their faction auction house every ~10 minutes and buy out one
#                     affordable gear upgrade (best item-level gain within budget), collect the
#                     win from their mailbox and equip it. Characters on the AuctionHouseBot
#                     account never shop (the core destroys AHBot-flagged buyers' wins).
#        Default:     0 - (Disabled)

Playerbot.Pve.AuctionBuy.Enable = 0

#    Playerbot.Pve.AuctionBuy.BudgetPct
#        Description: Maximum share of a bot's money a single auction buyout may cost.
#        Default:     30

Playerbot.Pve.AuctionBuy.BudgetPct = 30

#    Playerbot.Pve.Professions.Enable
#        Description: Each bot takes two gathering professions (herbalism/mining/skinning,
#                     deterministic by character), learns and ranks them automatically, gathers
#                     herbs and ore it passes while grinding, skins its finished corpses, and
#                     sells the materials on vendor visits (unless a quest needs them).
#        Default:     0 - (Disabled)

Playerbot.Pve.Professions.Enable = 0
